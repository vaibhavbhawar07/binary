#include <stdio.h>
int main()
{
    int n, key, mid;
    printf("Enter the total numbers: ");
    scanf("%d", &n);
    int a[n];
    printf("Enter the chosen numbers (in sorted order):\n");
    for (int i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }
    printf("Enter the key: ");
    scanf("%d", &key);
    int i = 0, j = n - 1;
    while (i <= j)
    {
        mid = (i + j) / 2;
        if (a[mid] == key)
        {
            printf("Key %d is found at %d", key, mid);
            return 0;
        }
        else if (a[mid] < key)
        {
          i = mid + 1;
        }
        else
        {
            j = mid - 1;
        }
    }
    printf("Key not found");
    return 0;
}
